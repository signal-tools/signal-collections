{
	"name": "@signal-tools/collections",
	"version": "0.0.0",
	"description": "Signal-aware Array, Map, Set, and Object collections",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"homepage": "https://github.com/signal-tools/signal-collections#readme",
	"license": "MIT-0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"repository": "https://github.com/signal-tools/signal-collections",
	"bugs": "https://github.com/signal-tools/signal-collections/issues",
	"sideEffects": false,
	"keywords": [
		"array",
		"collection",
		"map",
		"object",
		"reactive",
		"reactivity",
		"set",
		"signal",
		"tc39"
	],
	"scripts": {
		"build": "tsc",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"package:check": "npm pack --dry-run",
		"test": "npm run test:node && npm run test:chromium && npm run test:firefox && npm run test:webkit",
		"test:chromium": "vitest run --browser.name=chromium",
		"test:firefox": "vitest run --browser.name=firefox",
		"test:node": "vitest run --config vitest.node.config.ts",
		"test:webkit": "vitest run --browser.name=webkit",
		"vitest": "vitest"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"peerDependencies": {
		"@signal-tools/signal": "0.0.0"
	},
	"packageManager": "npm@11.13.0",
	"allowScripts": {
		"dprint": true,
		"fsevents": true
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-istanbul": "4.1.10",
		"dprint": "0.51.1",
		"playwright": "1.62.1",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
